namespace Database\Factories;

use App\Models\Order;
use App\Models\User;
use Illuminate\Database\Eloquent\Factories\Factory;

class OrderFactory extends Factory
{
    protected $model = Order::class;

    public function definition(): array
    {
        return [
            // Asigna un usuario existente o crea uno si la tabla está vacía
            'user_id' => User::inRandomOrder()->first()->id ?? User::factory(),
            
            // Atributos simulados con FakerPHP
            'order_number' => 'ORD-' . $this->faker->unique()->numberBetween(10000, 99999),
            'total' => $this->faker->randomFloat(2, 15, 750), // decimal(8,2)
            'status' => $this->faker->randomElement(['pending', 'processing', 'completed', 'cancelled']),
            'created_at' => $this->faker->dateTimeThisYear(),
        ];
    }
}

